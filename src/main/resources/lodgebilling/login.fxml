<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.geometry.Pos?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.PasswordField?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lodge.Controller"
      alignment="CENTER"
      spacing="18"
      styleClass="login-background">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="LODGE BILLING SYSTEM"
           styleClass="login-title"/>

    <Label text="Welcome back! Please log in."
           styleClass="login-subtitle"/>

    <VBox spacing="8" maxWidth="350">

        <Label text="Username" styleClass="field-label"/>

        <TextField fx:id="usernameField"
                   promptText="Enter your username"
                   prefHeight="42"/>

        <Label text="Password" styleClass="field-label"/>

        <PasswordField fx:id="passwordField"
                       promptText="Enter your password"
                       prefHeight="42"
                       onAction="#handleLogin"/>

        <Label fx:id="messageLabel"
               wrapText="true"
               styleClass="error-message"/>

        <HBox spacing="12" alignment="CENTER">

            <Button text="Login"
                    onAction="#handleLogin"
                    prefWidth="160"
                    prefHeight="42"
                    styleClass="primary-button"/>

            <Button text="Clear"
                    onAction="#handleClear"
                    prefWidth="100"
                    prefHeight="42"
                    styleClass="secondary-button"/>

        </HBox>

        <Button text="Exit Application"
                onAction="#handleExit"
                maxWidth="Infinity"
                prefHeight="38"
                styleClass="exit-button"/>

    </VBox>

    <Label text="Lodge Management and Billing"
           styleClass="footer-text"/>

</VBox>