<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.geometry.Pos?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.image.Image?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lodge.DashboardController"
            styleClass="dashboard-background">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="235"
              spacing="14"
              styleClass="sidebar">

            <padding>
                <Insets top="22" right="18" bottom="22" left="18"/>
            </padding>

            <!-- Lodge Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12">

                <ImageView fitWidth="55"
                           fitHeight="55"
                           preserveRatio="true"
                           smooth="true">

                    <image>
                        <Image url="@images/logo.jpeg"
                               backgroundLoading="false"/>
                    </image>

                </ImageView>

                <VBox spacing="4">
                    <Label text="LODGE SYSTEM"
                           styleClass="sidebar-title"
                           wrapText="true"/>

                    <Label text="MANAGEMENT"
                           styleClass="sidebar-subtitle"/>
                </VBox>

            </HBox>

            <Label text="MAIN MENU"
                   styleClass="menu-heading"/>

            <Button text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Guest Management"
                    onAction="#openGuests"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Room Management"
                    onAction="#openRooms"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Billing &amp; Invoices"
                    onAction="#openBilling"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Payments"
                    onAction="#openPayments"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="Reports"
                    onAction="#openReports"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button text="User Management"
                    onAction="#openUsers"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="Logout"
                    onAction="#logout"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

        </VBox>
    </left>

    <!-- MAIN DASHBOARD CONTENT -->
    <center>
        <StackPane styleClass="dashboard-main">

            <!-- Background image -->
            <ImageView mouseTransparent="true"
                       fitWidth="1200"
                       fitHeight="900"
                       preserveRatio="false"
                       smooth="true"
                       styleClass="dashboard-background-image">

                <image>
                    <Image url="@images/Building.jpeg"
                           backgroundLoading="false"/>
                </image>

            </ImageView>

            <!-- Overlay keeps text readable over the image -->
            <VBox styleClass="dashboard-overlay"
                  fillWidth="true">

                <padding>
                    <Insets top="30" right="32" bottom="30" left="32"/>
                </padding>

                <VBox spacing="24"
                      alignment="TOP_CENTER">

                    <!-- Welcome section -->
                    <VBox spacing="9"
                          alignment="CENTER"
                          styleClass="welcome-panel"
                          maxWidth="950">

                        <Label text="Welcome to Your Lodge"
                               styleClass="welcome-title"
                               wrapText="true"/>

                        <Label text="Manage guests, rooms, invoices and payments in one place."
                               wrapText="true"
                               styleClass="welcome-description"/>

                    </VBox>

                    <!-- Urgent actions -->
                    <VBox spacing="15"
                          maxWidth="950"
                          fillWidth="true">

                        <Label text="URGENT ACTIONS"
                               styleClass="section-title"/>

                        <HBox spacing="16"
                              alignment="TOP_CENTER">

                            <!-- Guest management card -->
                            <VBox spacing="12"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="action-card">

                                <Label text="Guest Management"
                                       styleClass="card-title"
                                       wrapText="true"/>

                                <Label text="Register guests and manage their details."
                                       wrapText="true"
                                       styleClass="card-description"
                                       VBox.vgrow="ALWAYS"/>

                                <Button text="Manage Guests"
                                        onAction="#openGuests"
                                        maxWidth="Infinity"
                                        styleClass="primary-button"/>

                            </VBox>

                            <!-- Room management card -->
                            <VBox spacing="12"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="action-card">

                                <Label text="Room Management"
                                       styleClass="card-title"
                                       wrapText="true"/>

                                <Label text="Check room details and availability."
                                       wrapText="true"
                                       styleClass="card-description"
                                       VBox.vgrow="ALWAYS"/>

                                <Button text="Manage Rooms"
                                        onAction="#openRooms"
                                        maxWidth="Infinity"
                                        styleClass="primary-button"/>

                            </VBox>

                            <!-- Billing card -->
                            <VBox spacing="12"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="action-card">

                                <Label text="Billing &amp; Payments"
                                       styleClass="card-title"
                                       wrapText="true"/>

                                <Label text="Manage invoices, payments and outstanding balances."
                                       wrapText="true"
                                       styleClass="card-description"
                                       VBox.vgrow="ALWAYS"/>

                                <Button text="Open Billing"
                                        onAction="#openBilling"
                                        maxWidth="Infinity"
                                        styleClass="primary-button"/>

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- Dashboard information panel -->
                    <VBox spacing="12"
                          maxWidth="950"
                          fillWidth="true"
                          styleClass="information-panel">

                        <Label fx:id="contentTitle"
                               text="Dashboard"
                               styleClass="section-title"
                               wrapText="true"/>

                        <Label fx:id="contentMessage"
                               text="Welcome! Select a section from the sidebar or choose an urgent action above."
                               wrapText="true"
                               styleClass="content-message"/>

                    </VBox>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>